  "web_honeypot_routes": [
    { "path": "/", "method": "GET", "surface": "Trang chủ Cổng thông tin dịch vụ công" },
    { "path": "/auth/login", "method": "GET, POST", "surface": "Đăng nhập công dân (bẫy Brute Force & SQLi)" },
    { "path": "/tra-cuu", "method": "GET", "surface": "Tra cứu thủ tục (bẫy Reflected XSS)" },
    { "path": "/gop-y", "method": "GET, POST", "surface": "Ý kiến công dân (bẫy Stored XSS)" },
    { "path": "/ho-so/<case_id>", "method": "GET", "surface": "Xem chi tiết hồ sơ (bẫy IDOR, Canary token)" },
    { "path": "/download", "method": "GET", "surface": "Tải biểu mẫu (bẫy Path Traversal, giả lập /etc/passwd)" },
    { "path": "/tich-hop", "method": "GET", "surface": "Tích hợp liên ngành (bẫy Remote File Inclusion)" },
    { "path": "/upload", "method": "GET, POST", "surface": "Nộp tệp đính kèm (bẫy File Upload, chuyển sang .bin)" },
    { "path": "/diagnostics", "method": "GET", "surface": "Chẩn đoán kết nối (bẫy Command Injection, trả về www-data)" },
    { "path": "/xml/import", "method": "GET, POST", "surface": "Nhập dữ liệu biểu mẫu XML (bẫy XXE Injection)" }
  ],
  "ingestion_pipelines": [
    {
      "name": "Pipeline 1: Web Honeypot",
      "source": "part_02_WEB_HONEYPOT Flask App",
      "local_store": "SQLite (honeypot.sqlite3)",
      "forwarder": "part2-forwarder (scripts/forward_part2.py, polling 2s, in-memory cursor)",
      "destination": "FastAPI (POST /api/v1/events) -> PostgreSQL 17 (events table)"
    },
    {
      "name": "Pipeline 2: SSH Honeypot",
      "source": "Cowrie SSH daemon (Port 2222)",
      "local_store": "JSON (cowrie.json)",
      "forwarder": "cowrie-forwarder (scripts/forward_cowrie.py, stream follow)",
      "destination": "FastAPI (POST /api/v1/events) -> PostgreSQL 17 (events table)"
    },
    {
      "name": "Pipeline 3: Network IDS",
      "source": "Suricata Engine (Custom Rules 9900001-9900010)",
      "local_store": "JSON (eve.json)",
      "forwarder": "ids_bridge.collector (--type suricata)",
      "destination": "FastAPI (POST /api/v1/events) -> PostgreSQL 17 (events table)"
    },
    {
      "name": "Pipeline 4: Machine Learning Sensor",
      "source": "Npcap / Scapy Packet Sniffer",
      "processing": "Extract 46 CICIoT2023 features -> XGBoost Predictor",
      "forwarder": "ids_bridge.live_sensor -> Ingest API Gateway (:8090)",
      "destination": "FastAPI (POST /api/v1/events) -> PostgreSQL 17 (events table)"
    }
  ],
  "suricata_custom_rules": [
    { "sid": 9900001, "msg": "HONEYPOT possible SQL injection", "classtype": "web-application-attack" },
    { "sid": 9900002, "msg": "HONEYPOT reflected XSS payload", "classtype": "web-application-attack" },
    { "sid": 9900003, "msg": "HONEYPOT path traversal", "classtype": "web-application-attack" },
    { "sid": 9900004, "msg": "HONEYPOT command injection", "classtype": "web-application-attack" },
    { "sid": 9900005, "msg": "HONEYPOT XXE payload", "classtype": "web-application-attack" },
    { "sid": 9900006, "msg": "HONEYPOT remote include attempt", "classtype": "web-application-attack" },
    { "sid": 9900007, "msg": "HONEYPOT executable upload name", "classtype": "web-application-attack" },
    { "sid": 9900008, "msg": "HONEYPOT repeated login requests", "classtype": "attempted-admin" },
    { "sid": 9900009, "msg": "HONEYPOT restricted record IDOR", "classtype": "web-application-attack" },
    { "sid": 9900010, "msg": "HONEYPOT stored XSS submission", "classtype": "web-application-attack" }
  ],
  "machine_learning_model": {
    "model_name": "xgboost_original",
    "model_file": "part_01_AI_ML/artifacts/xgboost_original.ubj",
    "manifest_file": "part_01_AI_ML/artifacts/manifest.json",
    "feature_count": 46,
    "feature_standard": "CICIoT2023",
    "feature_profile": "ciciot2023-live-pcap-v1",
    "class_names": [
      "Benign",
      "BruteForce",
      "DDoS",
      "DoS",
      "Mirai",
      "Recon",
      "Spoofing"
    ]
  },
  "correlation_rules": [
    {
      "id": "repeated_login_activity",
      "title": "Một nguồn thử đăng nhập nhiều lần",
      "type": "threshold",
      "field": "path",
      "equals": "/auth/login",
      "count": 5,
      "window_seconds": 60,
      "severity": "high"
    },
    {
      "id": "multi_vector_probe",
      "title": "Một nguồn thử nhiều kiểu tương tác",
      "type": "distinct",
      "field": "vulnerability",
      "count": 3,
      "window_seconds": 600,
      "severity": "critical"
    },
    {
      "id": "upload_then_command",
      "title": "Tải tệp lên rồi thử nhập lệnh",
      "type": "sequence",
      "field": "vulnerability",
      "values": ["unrestricted_file_upload", "command_injection"],
      "window_seconds": 900,
      "severity": "critical"
    },
    {
      "id": "high_request_rate",
      "title": "Lượng truy cập vào Honeypot tăng cao",
      "type": "threshold",
      "field": "event_type",
      "equals": "request",
      "count": 50,
      "window_seconds": 60,
      "severity": "high"
    }
  ],
